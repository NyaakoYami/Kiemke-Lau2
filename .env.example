# Server-only Supabase credentials.
# NEVER prefix the secret key with VITE_ and never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_new_secret_key

# Optional local/frontend publishable key. The current app does not need it
# because all database writes go through /api/sync on the server.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
